rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    // Deactivated staff (users/{uid}.active == false) lose access immediately,
    // even mid-session. Docs without the field count as active.
    function isActive()    { return userDoc().get('active', true) != false; }

    function isManager()   { return isAuth() && (role() == 'clinic_manager' || role() == 'manager') && isActive(); }
    function isPhysio()    { return isAuth() && role() == 'physiotherapist' && isActive(); }
    function isSecretary() { return isAuth() && role() == 'secretary' && isActive(); }
    function isPatient()   { return isAuth() && role() == 'patient';          }
    function isPhysician() { return isAuth() && role() == 'physician';        }
    function isPartner()   { return isAuth() && role() == 'partner';          }
    function isViewer()    { return isAuth() && role() == 'viewer';              }
    function isStaff()     { return isManager() || isPhysio() || isSecretary(); }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Each user can read/update their own profile; manager can read all.
    match /users/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isManager());
      allow create: if isAuth() && (request.auth.uid == uid || isManager());
      // Users may edit their own doc, but never their own role or active flag —
      // otherwise anyone could promote themselves or undo a deactivation.
      allow update: if isAuth() && (
        isManager() ||
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('active', true) == resource.data.get('active', true))
      );
      allow delete: if isManager();
    }

    // ── Physiotherapists ──────────────────────────────────────────────────────
    match /physiotherapists/{uid} {
      allow read:  if isStaff() || isPatient();
      allow write: if isManager() || (isPhysio() && request.auth.uid == uid);
    }

    // ── Secretaries ───────────────────────────────────────────────────────────
    match /secretaries/{uid} {
      allow read:  if isStaff();
      allow write: if isManager();
    }

    // ── Viewers ───────────────────────────────────────────────────────────────
    match /viewers/{uid} {
      allow read:  if isManager() || (isViewer() && request.auth.uid == uid);
      allow write: if isManager();
    }

    // ── Physicians ────────────────────────────────────────────────────────────
    match /physicians/{uid} {
      allow read:  if isStaff() || isPhysician();
      allow write: if isManager();
    }

    // ── Physician Notes ───────────────────────────────────────────────────────
    match /physicianNotes/{docId} {
      allow read:   if isStaff() || isPhysician();
      allow create: if isPhysician() && request.resource.data.physicianId == request.auth.uid;
      allow update: if isManager() || (isPhysician() && resource.data.physicianId == request.auth.uid);
      allow delete: if isManager() || (isPhysician() && resource.data.physicianId == request.auth.uid);
    }

    // ── Partners ──────────────────────────────────────────────────────────────
    match /partners/{uid} {
      allow read:  if isManager() || (isPartner() && request.auth.uid == uid);
      allow write: if isManager();
    }

    // ── Patients ──────────────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow read:            if isAuth() && (isStaff() || isPatient() || isPhysician() || isViewer() ||
                               (isPartner() && resource.data.referredByPartnerId == request.auth.uid));
      allow create:          if isStaff() || (isAuth() && request.auth.uid == patientId);
      allow update, delete:  if isStaff();
    }

    // ── Patient sub-collections ───────────────────────────────────────────────
    match /patientProfiles/{patientId} {
      allow read:  if isAuth();
      allow write: if isStaff();
    }

    match /patientAssessments/{patientId} {
      allow read:  if isStaff() || isPhysician();
      allow write: if isManager() || isPhysio();
    }

    match /patientDiagnosis/{patientId} {
      allow read:  if isStaff() || isPhysician();
      allow write: if isManager() || isPhysio();
    }

    match /patientSessions/{docId} {
      allow read:  if isStaff() || isPatient() || isPhysician();
      allow write: if isManager() || isPhysio();
    }

    match /patientDocuments/{docId} {
      allow read:   if isStaff() || isPatient() || isPhysician();
      allow create: if isStaff() || (isPatient() && request.resource.data.uploadedBy == request.auth.uid && request.resource.data.patientId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isStaff() || (isPatient() && resource.data.patientId == request.auth.uid && resource.data.uploadedBy == request.auth.uid);
    }

    match /patientExercises/{docId} {
      allow read:          if isStaff() || isPatient() || isPhysician();
      allow create, delete: if isManager() || isPhysio();
      allow update:        if isManager() || isPhysio() || isPatient();
    }

    match /assignedExercises/{docId} {
      allow read:  if isStaff() || isPatient();
      allow write: if isManager() || isPhysio();
    }

    match /sessionFeedback/{docId} {
      allow read:          if isStaff() || isPatient();
      allow create:        if isStaff() || (isPatient() && request.resource.data.patientId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // ── Body Profile (Joint Assessment) ───────────────────────────────────────
    match /jointAssessments/{patientId} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    match /jointAssessmentHistory/{patientId}/snapshots/{snapId} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    // ── Appointments ─────────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read:          if isStaff() || isPatient() || isViewer();
      allow create:        if isStaff() || (isPatient() && request.resource.data.patientId == request.auth.uid);
      allow update:        if isStaff();
      allow delete:        if isStaff() || (isPatient() && resource.data.patientId == request.auth.uid);
    }

    // ── Exercise Library ─────────────────────────────────────────────────────
    match /exerciseLibrary/{exerciseId} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    // ── Treatment Protocols ───────────────────────────────────────────────────
    match /treatmentProtocols/{protocolId} {
      allow read:  if isStaff();
      allow write: if isManager();
    }

    // ── Diagnosis Templates ───────────────────────────────────────────────────
    match /diagnosisTemplates/{templateId} {
      allow read:  if isManager();
      allow write: if isManager();
    }

    // ── Patient Protocol Assignments ──────────────────────────────────────────
    match /patientProtocols/{docId} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    // ── Explosive Power Assessments ───────────────────────────────────────────
    match /explosivePowerSessions/{docId} {
      allow read:   if isStaff();
      allow create: if isManager() || isPhysio();
      allow delete: if isManager() || isPhysio();
    }

    // ── Nutrition Plans ───────────────────────────────────────────────────────
    match /nutritionProfiles/{patientId} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    // ── Nutrition Assessment History (baseline + biweekly reassessments) ──────
    match /nutritionAssessmentHistory/{patientId}/snapshots/{date} {
      allow read:  if isStaff();
      allow write: if isManager() || isPhysio();
    }

    // ── Clinic Settings ──────────────────────────────────────────────────────
    match /clinicSettings/{docId} {
      allow read:  if isStaff() || isPatient();
      allow write: if isManager();
    }

    // ── Schedule ─────────────────────────────────────────────────────────────
    match /schedule/{docId} {
      allow read:  if isStaff();
      allow write: if isManager();
    }

    // ── Billing & Pricing (manager + secretary only) ─────────────────────────
    match /patientBilling/{docId} {
      allow read:          if isManager() || isSecretary();
      allow write:         if isManager() || isSecretary();
    }

    match /patientSessionPrices/{docId} {
      allow read:          if isManager() || isSecretary() || isPhysio();
      allow write:         if isManager() || isSecretary();
    }

    match /patientPackages/{docId} {
      allow read:  if isManager() || isSecretary() || isPhysio() || isViewer() ||
                     (isPartner() && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.referredByPartnerId == request.auth.uid);
      allow write: if isManager() || isSecretary() || isPhysio();
    }

    // ── Business Analytics data (manager-only financials) ────────────────────
    // Monthly expense totals: one doc per month + category, id `${month}__${categoryId}`
    // (so duplicates are impossible), amount ≥ 0. Older per-transaction docs can
    // still be read and deleted, but not created or edited.
    match /clinicExpenses/{docId} {
      allow read, delete: if isManager();
      allow create, update: if isManager()
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.categoryId is string
        && docId == request.resource.data.month + '__' + request.resource.data.categoryId
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
    }

    match /businessSettings/{docId} {
      allow read, write: if isManager();
    }

    // Front-desk inquiry log (may hold a name/phone) — manager + secretary only.
    match /leads/{docId} {
      allow read, update, delete: if isManager() || isSecretary();
      allow create: if (isManager() || isSecretary())
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0;
    }

    // Dated log of package paidAmount changes — written by whoever edits a
    // package (same roles as patientPackages), corrected only by the manager.
    match /packagePayments/{docId} {
      allow read:           if isManager() || isSecretary();
      allow create:         if isManager() || isSecretary() || isPhysio();
      allow update, delete: if isManager();
    }

    // ── Physio+ Loyalty Club ─────────────────────────────────────────────────
    // Earn-side writes come from priceService.ts (staff already trusted with
    // direct billing writes elsewhere in this file). Voucher *creation* is
    // Admin-SDK-only (redeemLoyaltyPoints Cloud Function) since that's the
    // patient-initiated, money-equivalent step that needs server-side balance
    // validation — client create is denied here on purpose.
    match /patientPoints/{patientId} {
      allow read:  if isStaff() || (isPatient() && request.auth.uid == patientId);
      allow write: if isManager() || isSecretary();
    }

    match /pointsLedger/{docId} {
      allow read:  if isStaff() || (isPatient() && resource.data.patientId == request.auth.uid);
      allow write: if isManager() || isSecretary();
    }

    match /pointsVouchers/{docId} {
      allow read:   if isStaff() || (isPatient() && resource.data.patientId == request.auth.uid);
      allow create: if false;
      allow update: if isManager() || isSecretary();
    }

    // ── Staff Attendance (manager + secretary only — not the physios being tracked) ──
    match /staffAttendance/{docId} {
      allow read:  if isManager() || isSecretary();
      allow write: if isManager() || isSecretary();
    }

    // ── Daily Check-ins ───────────────────────────────────────────────────────
    match /dailyCheckIns/{docId} {
      allow read:          if isStaff() || isPatient();
      allow create, update: if isPatient() && request.resource.data.patientId == request.auth.uid;
      allow delete:        if isManager();
    }

    // ── Exercise Streak Log ───────────────────────────────────────────────────
    match /exerciseStreakLog/{docId} {
      allow read:          if isStaff() || isPatient();
      allow create, update: if isPatient() && request.resource.data.patientId == request.auth.uid;
      allow delete:        if isManager();
    }

    // ── Online Rehabilitation ─────────────────────────────────────────────────
    match /onlineRehabEnrollments/{docId} {
      allow read:  if isStaff() || isPhysician();
      allow write: if isManager() || isPhysio();
    }

    match /onlineRehabPrograms/{docId} {
      allow read:  if isStaff() || isPhysician();
      allow write: if isManager() || isPhysio();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, update, delete: if isAuth() && request.auth.uid == userId;
      allow create:               if isAuth();
    }

    // ── WhatsApp Sessions ─────────────────────────────────────────────────────
    match /whatsappSessions/{phone} {
      allow read, write: if false; // admin SDK only
    }

  }
}
